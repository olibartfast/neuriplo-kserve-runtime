# Stable versions of third-party dependencies.
# Pin these to known-good tags; bump when upgrading.
NEURIPLO_VERSION=v0.10.0
# Task layer, used only by pipeline (ensemble) preprocess/postprocess steps
# (-DNEURIPLO_RUNTIME_ENABLE_TASKS=ON). v0.8.0 lacks decodeImage (added in
# v0.8.1), so NEURIPLO_RUNTIME_ENABLE_TASKS=ON does not compile against it.
NEURIPLO_TASKS_VERSION=v0.8.2
